# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/dbname

# Gemini API Configuration (REQUIRED)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent
GEMINI_TIMEOUT=30

# Toss Cert Authentication Configuration (REQUIRED for auth features)
# Get your credentials from Toss Developer Portal
TOSS_CERT_CLIENT_ID=your-toss-client-id-here
TOSS_CERT_CLIENT_SECRET=your-toss-client-secret-here
TOSS_CERT_OAUTH_URL=https://oauth2.cert.toss.im
TOSS_CERT_BASE_URL=https://cert.toss.im
TOSS_CERT_TIMEOUT=30

# Server Configuration
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

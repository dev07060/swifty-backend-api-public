# Production Environment Variables for GCP Cloud Run
# Copy this file to .env.production and fill in your actual values
# DO NOT commit .env.production to version control!

# =====================================================
# Database Configuration (Cloud SQL)
# =====================================================
# For Cloud Run, use Unix socket connection
# Format: /cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DB_HOST=/cloudsql/your-project-id:your-region:swifty-postgres
DB_PORT=5432
DB_NAME=swifty
DB_USER=swifty_user
DB_PASSWORD=your-secure-database-password-here

# Alternative: Use public IP with Cloud SQL Proxy (not recommended for production)
# DB_HOST=YOUR_CLOUD_SQL_PUBLIC_IP
# DB_PORT=5432

# =====================================================
# Gemini API Configuration
# =====================================================
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent
GEMINI_TIMEOUT=30

# =====================================================
# Server Configuration
# =====================================================
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

# Environment (production, staging, development)
ENVIRONMENT=production

# =====================================================
# CORS Configuration
# =====================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://app-swifty-healthy.apps.tossmini.com,https://app-swifty-healthy.private-apps.tossmini.com

# For development/testing, you can add localhost
# CORS_ORIGINS=https://app-swifty-healthy.apps.tossmini.com,https://app-swifty-healthy.private-apps.tossmini.com,http://localhost:3000

# =====================================================
# Cloud Run Specific (automatically set by Cloud Run)
# =====================================================
# PORT=8080  # Set automatically by Cloud Run
# K_SERVICE=swifty-api
# K_REVISION=swifty-api-00001
# K_CONFIGURATION=swifty-api
